# Native OpenUSD runtime binaries are tracked with Git LFS.
# (Plain extensions only — does not match Unity ".*.meta" sidecar files, which stay text.)
*.dll   filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.so.*  filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text
*.pdb   filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
# Keep Unity .meta files as normal text (never LFS) — the trailing rule clears the
# filter that "*.so.*" would otherwise apply to versioned sidecars like libtbb.so.2.meta.
*.meta  text -filter -diff -merge
DevSamples~/**/*.jpg filter=lfs diff=lfs merge=lfs -text
DevSamples~/**/*.exr filter=lfs diff=lfs merge=lfs -text
DevSamples~/**/*.usd filter=lfs diff=lfs merge=lfs -text
DevSamples~/**/*.png filter=lfs diff=lfs merge=lfs -text
