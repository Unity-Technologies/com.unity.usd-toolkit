# Native OpenUSD runtime binaries are tracked with Git LFS.
# (Plain extensions only — does not match Unity ".*.meta" sidecar files, which stay text.)
*.dll   filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.so.*  filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text
*.pdb   filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
# Keep Unity .meta files as normal text (never LFS) — the trailing rule clears the
# filter that "*.so.*" would otherwise apply to versioned sidecars like libtbb.so.2.meta.
*.meta  text -filter -diff -merge

# OpenUSD plugin descriptors are hashed byte-for-byte by the runtime integrity
# check (SECURITY-282834, CWE-494), so their bytes must be identical on every
# checkout. Without -text, core.autocrlf=true rewrites them to CRLF on Windows
# and the digests in Runtime/Native/NativeRuntimeHashes.g.cs stop matching --
# invisibly, because autocrlf converts back when git compares.
Runtime/Plugins/**/*.usda         -text
Runtime/Plugins/**/*.glslfx       -text
Runtime/Plugins/**/*.mtlx         -text
Runtime/Plugins/**/plugInfo.json  -text

# The MaterialX shader sources beside the .mtlx files (.glsl, .osl, .mdl, .metal, .h) are not
# hashed at run time, but the SBOM records a tree digest over the whole library folder. With
# autocrlf they check out as CRLF on Windows, so generate_sbom.py run there writes a digest
# that matches no other checkout, and a pack made there ships them converted. (.mtlx is above.)
Runtime/Plugins/**/usdMtlx/resources/libraries/**/*.glsl  -text
Runtime/Plugins/**/usdMtlx/resources/libraries/**/*.osl  -text
Runtime/Plugins/**/usdMtlx/resources/libraries/**/*.mdl  -text
Runtime/Plugins/**/usdMtlx/resources/libraries/**/*.metal  -text
Runtime/Plugins/**/usdMtlx/resources/libraries/**/*.h  -text

# A patch applied to the OpenUSD tree is pinned by SHA-256 in Native~/dependency-sources, so a
# Windows checkout converting it to CRLF would make every Windows build refuse it.
Native~/patches/*.patch  -text

# USD files shipped with the Runtime Demo sample are tracked with Git LFS. The rule is scoped to
# this folder so the hashed Runtime/Plugins/**/*.usda descriptors above stay plain text.
Samples~/Runtime[[:space:]]Demo/USDSamples/*.usda  filter=lfs diff=lfs merge=lfs -text
Samples~/Runtime[[:space:]]Demo/USDSamples/*.usdc  filter=lfs diff=lfs merge=lfs -text

# Animated GIFs used as README and sample hero images are large, so they are tracked with Git LFS.
Documentation~/images/*.gif  filter=lfs diff=lfs merge=lfs -text
