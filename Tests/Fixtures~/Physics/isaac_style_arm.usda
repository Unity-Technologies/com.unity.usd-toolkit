#usda 1.0
(
    doc = """A small articulated arm laid out the way Isaac Sim robots are: a PhysicsArticulationRootAPI
prim whose links are siblings, each joint under its parent link, a fixed joint to the world, angular
drives in Isaac Sim's per-degree units, a guide-purpose collision mesh with a convex hull
approximation, a physics material and mass properties. Beside it a free body hinged to the world
and a static ground, out of the arm's reach. The values are chosen so the import can be checked one to one: asymmetric
limits, a joint whose frame turns its X axis onto world Y, and a prismatic joint."""
    defaultPrim = "arm_robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
    uint physxScene:timeStepsPerSecond = 120
}

def Scope "Looks"
{
    def Material "Rubber" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.8
        float physics:restitution = 0.1
        float physics:staticFriction = 0.9
    }

    def Material "Orange"
    {
        token outputs:surface.connect = </Looks/Orange/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.45, 0.1)
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }

    def Material "Grey"
    {
        token outputs:surface.connect = </Looks/Grey/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.35, 0.36, 0.38)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
}

def Xform "arm_robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 0
    int physxArticulation:solverPositionIterationCount = 32
    int physxArticulation:solverVelocityIterationCount = 1

    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 4
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0167, 0.0167, 0.0267)
        double3 xformOp:translate = (0, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            rel material:binding = </Looks/Grey>
            double3 xformOp:scale = (0.2, 0.2, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def PhysicsRevoluteJoint "shoulder_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </arm_robot/base_link>
            rel physics:body1 = </arm_robot/shoulder_link>
            point3f physics:localPos0 = (0, 0, 0.05)
            point3f physics:localPos1 = (0, 0, -0.05)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150
            float physics:upperLimit = 150
            float drive:angular:physics:stiffness = 400
            float drive:angular:physics:damping = 40
            float drive:angular:physics:maxForce = 87
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.05
        }
    }

    def Xform "shoulder_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1.5
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0022, 0.0022, 0.0019)
        double3 xformOp:translate = (0, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.1
            double radius = 0.06
            rel material:binding = </Looks/Orange>
            rel material:binding:physics = </Looks/Rubber> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        def PhysicsRevoluteJoint "shoulder_pitch" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            # Axis X turned 90 degrees about Z by both frames: the joint turns about world Y.
            uniform token physics:axis = "X"
            rel physics:body0 = </arm_robot/shoulder_link>
            rel physics:body1 = </arm_robot/upper_arm>
            point3f physics:localPos0 = (0, 0, 0.05)
            point3f physics:localPos1 = (0, 0, -0.2)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -10
            float physics:upperLimit = 135
            float drive:angular:physics:stiffness = 600
            float drive:angular:physics:damping = 60
            float drive:angular:physics:maxForce = 87
            float drive:angular:physics:targetPosition = 0
        }
    }

    def Xform "upper_arm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1.2
        point3f physics:centerOfMass = (0, 0, 0.02)
        float3 physics:diagonalInertia = (0.0105, 0.0105, 0.001)
        double3 xformOp:translate = (0, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Capsule "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.3
            double radius = 0.04
            rel material:binding = </Looks/Orange>
        }

        def PhysicsRevoluteJoint "elbow" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </arm_robot/upper_arm>
            rel physics:body1 = </arm_robot/forearm>
            point3f physics:localPos0 = (0, 0, 0.2)
            point3f physics:localPos1 = (0, 0, -0.15)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -120
            float physics:upperLimit = 5
            float drive:angular:physics:stiffness = 300
            float drive:angular:physics:damping = 30
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:targetPosition = -30
            float state:angular:physics:position = -30
            float state:angular:physics:velocity = 0
        }
    }

    def Xform "forearm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.8
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0062, 0.0062, 0.0004)
        double3 xformOp:translate = (0, 0, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "visual" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            rel material:binding = </Looks/Grey>
            double3 xformOp:scale = (0.06, 0.06, 0.3)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        # Isaac Sim's collision layout: a guide-purpose mesh the renderer skips, approximated by its hull.
        def Mesh "collisions" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            uniform token physics:approximation = "convexHull"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            point3f[] points = [(-0.035, -0.035, -0.15), (0.035, -0.035, -0.15), (-0.035, 0.035, -0.15), (0.035, 0.035, -0.15), (-0.035, -0.035, 0.15), (0.035, -0.035, 0.15), (-0.035, 0.035, 0.15), (0.035, 0.035, 0.15)]
        }

        def PhysicsPrismaticJoint "slider" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </arm_robot/forearm>
            rel physics:body1 = </arm_robot/gripper>
            point3f physics:localPos0 = (0, 0, 0.15)
            point3f physics:localPos1 = (0, 0, -0.03)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.08
            float drive:linear:physics:stiffness = 400
            float drive:linear:physics:damping = 80
            float drive:linear:physics:maxForce = 20
            float drive:linear:physics:targetPosition = 0.02
        }
    }

    def Xform "gripper" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.1
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.00004, 0.00004, 0.00002)
        double3 xformOp:translate = (0, 0, 0.93)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            rel material:binding = </Looks/Orange>
            double3 xformOp:scale = (0.03, 0.08, 0.06)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    # Isaac Sim's fixed base: a joint from the root link to the world.
    def PhysicsFixedJoint "rootJoint"
    {
        rel physics:body1 = </arm_robot/base_link>
        point3f physics:localPos0 = (0, 0, 0.05)
        point3f physics:localPos1 = (0, 0, 0)
    }
}

def Sphere "pendulum_bob" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
)
{
    double radius = 0.05
    float physics:mass = 0.5
    rel material:binding = </Looks/Orange>
    double3 xformOp:translate = (0, 1.1, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def PhysicsRevoluteJoint "pendulum_hinge"
{
    uniform token physics:axis = "Y"
    rel physics:body1 = </pendulum_bob>
    point3f physics:localPos0 = (0, 1.1, 0.8)
    point3f physics:localPos1 = (0, 0, 0.3)
    quatf physics:localRot0 = (1, 0, 0, 0)
    quatf physics:localRot1 = (1, 0, 0, 0)
    float physics:lowerLimit = -60
    float physics:upperLimit = 30
}

def Cube "ground" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
)
{
    double size = 1
    rel material:binding = </Looks/Grey>
    double3 xformOp:translate = (0, 0, -0.01)
    double3 xformOp:scale = (3, 3.2, 0.02)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
