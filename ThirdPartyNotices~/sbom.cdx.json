      "name": "com.unity.usd-toolkit",
      "version": "0.7.2-exp.1",
      "description": "Runtime USD toolkit for Unity applications using a custom native OpenUSD wrapper. A C# integration layer for connecting Unity to NVIDIA's Omniverse/OpenUSD ecosystem. Wraps Pixar's OpenUSD 26.05 native binaries via P/Invoke so Unity can read, write, and round-trip USD stages.",
      "licenses": [
        {
          "license": {
            "name": "Unity Companion License / see LICENSE.md"
          }
        }
      ]
    },
    "properties": [
      {
        "name": "unity:securityTicket",
        "value": "SECURITY-282834"
      },
      {
        "name": "unity:provenanceNote",
        "value": "Every OpenUSD payload is built from the public v26.05 tag (commit 2095faf) with the flags recorded on the OpenUSD component. The builds are not bit-reproducible: no SOURCE_DATE_EPOCH, absolute build paths are embedded, and the macOS payload is post-processed with install_name_tool and codesign. The SHA-256 values here identify what shipped; they do not prove upstream authenticity."
      }
    ]
