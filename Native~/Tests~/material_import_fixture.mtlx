<?xml version="1.0"?>
<!-- Shaped like OpenChessSet's King_mat.mtlx: standard_surface inputs fed from a nodegraph of
     image nodes, the normal through a normalmap node. The textures need not exist; the importer
     reports paths and never opens them. -->
<materialx version="1.38" fileprefix="tex/">
  <nodegraph name="NG_Piece">
    <image name="base_color_image" type="color3">
      <input name="file" type="filename" value="piece_base_color.jpg" colorspace="srgb_texture" />
    </image>
    <output name="base_color_output" type="color3" nodename="base_color_image" />
    <image name="metalness_image" type="float">
      <input name="file" type="filename" value="piece_metallic.jpg" />
    </image>
    <output name="metalness_output" type="float" nodename="metalness_image" />
    <image name="normal_image" type="vector3">
      <input name="file" type="filename" value="piece_normal.jpg" />
    </image>
    <normalmap name="normalmap" type="vector3">
      <input name="in" type="vector3" nodename="normal_image" />
    </normalmap>
    <output name="normal_output" type="vector3" nodename="normalmap" />
  </nodegraph>
  <standard_surface name="SR_Piece" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_Piece" output="base_color_output" />
    <input name="metalness" type="float" nodegraph="NG_Piece" output="metalness_output" />
    <input name="normal" type="vector3" nodegraph="NG_Piece" output="normal_output" />
  </standard_surface>
  <surfacematerial name="M_Piece" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Piece" />
  </surfacematerial>
  <standard_surface name="SR_Board" type="surfaceshader">
    <input name="base" type="float" value="0.5" />
    <input name="base_color" type="color3" value="0.8, 0.4, 0.2" />
    <input name="metalness" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.6" />
    <input name="emission" type="float" value="2.0" />
    <input name="emission_color" type="color3" value="0.1, 0.2, 0.3" />
  </standard_surface>
  <surfacematerial name="M_Board" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Board" />
  </surfacematerial>
</materialx>
