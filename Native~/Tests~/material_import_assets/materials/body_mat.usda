#usda 1.0
(
    doc = """A material layer in a sub-folder whose texture path is relative to this layer, not
    to the stage that references it (the Vehicle Variants layout). material_import_test checks
    that the importer hands back the path relative to the stage folder --
    material_import_assets/textures/body.png -- rather than the authored ../textures/body.png,
    which, joined onto the stage folder, would climb out of it and be refused."""
)

def Material "BodyMat"
{
    token outputs:surface.connect = </BodyMat/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </BodyMat/BodyTexture.outputs:rgb>
        float inputs:metallic = 0
        float inputs:roughness = 0.5
        token outputs:surface
    }

    def Shader "BodyTexture"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/body.png@
        token inputs:sourceColorSpace = "sRGB"
        float2 inputs:st.connect = </BodyMat/BodyUv.outputs:result>
        float3 outputs:rgb
    }

    def Shader "BodyUv"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        token inputs:varname = "st"
        float2 outputs:result
    }
}
