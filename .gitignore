# Native build intermediates / caches (regenerated by Native~ build scripts).
Native~/build~/
Build~/
build~/

# OS / editor junk
.DS_Store
Thumbs.db

# Python bytecode from the Native~ build/verification scripts
__pycache__/
*.pyc

# Local test data. Scene exports and the files they reference stay next to a test project:
# the package is installed from this tree as-is, so anything committed here reaches every consumer.
DevSamples~/
*.usd
*.usdc
*.usdz
*.usda
!Runtime/Plugins/**/*.usda
!Native~/Tests~/*.usda
!Native~/Tests~/**/*.usda
# Damaged binary layers file_format_test replays (a few KB each).
!Native~/Tests~/fuzz_regressions/*.usdc
!Tests/Fixtures~/**/*.usda
# Binary twins of the time-metadata fixtures, so the stage API is read from a crate too (~1 KB each).
!Tests/Fixtures~/Time/*.usdc
# The Runtime Demo sample ships its own USD files (tracked with Git LFS, see .gitattributes).
!Samples~/Runtime Demo/USDSamples/*.usda
!Samples~/Runtime Demo/USDSamples/*.usdc
